# --- Local development ---
# Base URL of the CivicFix backend API (browser talks to it directly).
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# --- Production (Vercel) ---
# Use the same-origin API proxy instead (see next.config.ts):
#   NEXT_PUBLIC_API_URL=/api/v1
#   BACKEND_URL=https://your-backend.fly.dev

# Shared with the API (backend PROXY_SHARED_SECRET, 32+ chars). proxy.ts sends it
# on auth routes so the API can rate-limit by the real client IP. Production only.
#   PROXY_SHARED_SECRET=<same value as on the API>

# Optional (production): public base URL of the report-images bucket, so
# /uploads is served straight from it (and cached by the CDN).
#   UPLOADS_URL=https://<branch>.storage.<region>.aws.neon.tech/report-images
