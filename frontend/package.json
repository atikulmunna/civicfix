{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "api-types": "openapi-typescript ../backend/openapi.json -o lib/api-schema.ts",
    "api-types:check": "openapi-typescript ../backend/openapi.json -o lib/api-schema.ts --check"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.105.1",
    "leaflet": "^1.9.4",
    "next": "16.4.3",
    "next-intl": "4.14.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@formatjs/icu-messageformat-parser": "3.5.18",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "jsdom": "^30.1.3",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "unrs-resolver": true
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    },
    "use-intl": "4.14.9",
    "icu-minify": "4.14.9"
  }
}
