# Copy to .env and adjust as needed.
NODE_ENV=development
PORT=5000

# Matches docker-compose.yml (service: db)
DATABASE_URL=postgresql://civicfix:civicfix@localhost:5434/civicfix
# Used by Prisma Migrate. Locally the same as DATABASE_URL; on Neon, the
# direct (non -pooler) connection string.
DATABASE_URL_UNPOOLED=postgresql://civicfix:civicfix@localhost:5434/civicfix

# Auth (Module 3)
JWT_ACCESS_SECRET=replace_me_with_a_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=7

# Uploads (Module 4)
UPLOAD_PROVIDER=local
LOCAL_UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=5242880

# CORS / rate limits
CORS_ORIGIN=http://localhost:3000

# Reverse proxies in front of the API (Express trust proxy). 0 locally, 1 on Fly.
TRUST_PROXY_HOPS=0
# Shared with the web app (frontend PROXY_SHARED_SECRET); lets the API rate-limit
# by the real client IP forwarded by the web proxy. Optional locally; 32+ chars.
# PROXY_SHARED_SECRET=
RATE_LIMIT_REPORTS_PER_HOUR=5
RATE_LIMIT_COMMENTS_PER_HOUR=20
