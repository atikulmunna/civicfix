{
  // Production build: compiles only app code (no tests, seed or tool configs)
  // from src/ into dist/, so `node dist/server.js` keeps working.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"]
}
