// CivicFix Prisma schema
// Source of truth: community_problem_reporting_platform_srs_v1.1.md (§8 Data Requirements, §26 State Machine)
//
// Notes:
// - Postgres + PostGIS. The PostGIS extension is created by the 0_init SQL
//   migration (not via Prisma's preview postgresqlExtensions, which reports
//   false drift). The `location` geography column on Report is kept in sync
//   with latitude/longitude by a DB trigger (1_postgis migration). The
//   `Unsupported("geography(Point, 4326)")` mapping lets Prisma round-trip the
//   column without managing its type; its GiST index is declared below so the
//   schema matches the migrations exactly (CI drift check).
// - All status-transition rules live in code (backend/src/modules/reports/status-machine.ts),
//   not in the DB, so they can return INVALID_STATUS_TRANSITION with context.

// Prisma 7 client: TypeScript generated into src/ (gitignored) and compiled
// with the app. ESM with .js import specifiers, as NodeNext requires.
generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

// Connection URLs live outside the schema since Prisma 7:
// - the app connects with DATABASE_URL (on Neon the pooled -pooler URL)
//   through the pg driver adapter (src/lib/prisma.ts);
// - the CLI (migrate, db execute) uses DATABASE_URL_UNPOOLED from
//   prisma.config.ts, because migrations need session state that a
//   transaction pooler drops.
// Locally both point at the same docker-compose database.
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  citizen
  department_worker
  admin
  super_admin
}

enum ReportStatus {
  SUBMITTED
  UNDER_REVIEW
  VERIFIED
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  REJECTED
  DUPLICATE
  NEEDS_MORE_INFO
  ARCHIVED
}

enum Severity {
  low
  medium
  high
  urgent
}

enum ImageType {
  before
  after
  evidence
}

enum VoteType {
  upvote
  confirm
  false_report
}

enum FixVerdict {
  confirmed
  disputed
}

enum NotificationType {
  status_change
  comment
  assignment
  system
}

enum SubscriptionSource {
  explicit
  owner
  confirm
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model User {
  id                 String   @id @default(uuid()) @db.Uuid
  name               String   @db.VarChar(120)
  email              String   @unique @db.VarChar(255)
  passwordHash       String   @map("password_hash")
  phone              String?  @db.VarChar(30)
  phoneIsPublic      Boolean  @default(false) @map("phone_is_public")
  // Chosen interface language, 'en' or 'bn' (F5); null until the user picks one.
  language           String?  @db.VarChar(2)
  role               UserRole @default(citizen)
  departmentId       String?  @map("department_id") @db.Uuid
  trustScore         Int      @default(0) @map("trust_score")
  isActive           Boolean  @default(true) @map("is_active")
  // Set when an admin resets the password; cleared when the user changes it.
  mustChangePassword Boolean  @default(false) @map("must_change_password")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  department      Department?          @relation(fields: [departmentId], references: [id])
  reports         Report[]             @relation("ReportReporter")
  comments        Comment[]
  votes           Vote[]
  fixChecks       FixCheck[]
  uploadedImages  ReportImage[]        @relation("ImageUploader")
  statusChanges   StatusHistory[]      @relation("StatusChanger")
  assignmentsMade ReportAssignment[]   @relation("AssignmentAuthor")
  subscriptions   ReportSubscription[]
  notifications   Notification[]
  refreshTokens   RefreshToken[]

  @@index([role])
  @@index([departmentId])
  @@map("users")
}

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(100)
  description String?
  icon        String?  @db.VarChar(100)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  reports Report[]

  @@map("categories")
}

model Department {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @unique @db.VarChar(120)
  description  String?
  contactEmail String?  @map("contact_email") @db.VarChar(255)
  phone        String?  @db.VarChar(30)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  members         User[]
  assignedReports Report[]           @relation("ReportAssignedDept")
  assignments     ReportAssignment[]

  @@map("departments")
}

model Report {
  id                   String                                 @id @default(uuid()) @db.Uuid
  userId               String                                 @map("user_id") @db.Uuid
  title                String                                 @db.VarChar(180)
  description          String
  categoryId           String                                 @map("category_id") @db.Uuid
  status               ReportStatus                           @default(SUBMITTED)
  severity             Severity
  latitude             Decimal                                @db.Decimal(9, 6)
  longitude            Decimal                                @db.Decimal(9, 6)
  // Managed via raw SQL/migration; derived from latitude/longitude on write.
  location             Unsupported("geography(Point, 4326)")?
  address              String?
  landmark             String?
  assignedDepartmentId String?                                @map("assigned_department_id") @db.Uuid
  // Triage priority (F1), stored so lists can sort by it: the score minus the
  // UTC day number the report was created on. Today's score is anchor + today's
  // day number, so the "+1 per day open" part needs no daily job. Null for
  // closed reports (resolved, rejected, duplicate, archived), which are not
  // ranked. Written only by modules/reports/triage.service.ts.
  priorityAnchor       Int?                                   @map("priority_anchor")
  // Number of `confirm` votes. Maintained by a trigger on votes (migration
  // *_report_confirm_count), never written by application code.
  confirmCount         Int                                    @default(0) @map("confirm_count")
  duplicateOfReportId  String?                                @map("duplicate_of_report_id") @db.Uuid
  internalNote         String?                                @map("internal_note")
  createdAt            DateTime                               @default(now()) @map("created_at")
  updatedAt            DateTime                               @updatedAt @map("updated_at")
  resolvedAt           DateTime?                              @map("resolved_at")

  reporter           User        @relation("ReportReporter", fields: [userId], references: [id])
  category           Category    @relation(fields: [categoryId], references: [id])
  assignedDepartment Department? @relation("ReportAssignedDept", fields: [assignedDepartmentId], references: [id])
  duplicateOf        Report?     @relation("ReportDuplicates", fields: [duplicateOfReportId], references: [id])
  duplicates         Report[]    @relation("ReportDuplicates")

  images        ReportImage[]
  comments      Comment[]
  votes         Vote[]
  fixChecks     FixCheck[]
  statusHistory StatusHistory[]
  assignments   ReportAssignment[]
  subscriptions ReportSubscription[]
  notifications Notification[]

  @@index([status])
  @@index([categoryId])
  @@index([createdAt])
  @@index([assignedDepartmentId])
  @@index([location], map: "idx_reports_location_gist", type: Gist)
  // "My reports" filters by reporter.
  @@index([userId])
  // "Highest priority" sort (closed reports, with no anchor, come last).
  @@index([priorityAnchor(sort: Desc), createdAt(sort: Desc)])
  // "Most confirmed" sort.
  @@index([confirmCount(sort: Desc), createdAt(sort: Desc)])
  // Map viewport filters by a latitude range, then a longitude range.
  @@index([latitude, longitude])
  // Text search uses ILIKE '%term%'; trigram GIN indexes serve it (pg_trgm is
  // created by the migration, like PostGIS).
  @@index([title(ops: raw("gin_trgm_ops"))], map: "idx_reports_title_trgm", type: Gin)
  @@index([description(ops: raw("gin_trgm_ops"))], map: "idx_reports_description_trgm", type: Gin)
  @@map("reports")
}

model ReportImage {
  id         String    @id @default(uuid()) @db.Uuid
  reportId   String    @map("report_id") @db.Uuid
  imageUrl   String    @map("image_url")
  storageKey String?   @map("storage_key")
  imageType  ImageType @map("image_type")
  uploadedBy String    @map("uploaded_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at")

  report   Report    @relation(fields: [reportId], references: [id], onDelete: Cascade)
  uploader User      @relation("ImageUploader", fields: [uploadedBy], references: [id])
  fixCheck FixCheck?

  @@index([reportId])
  @@map("report_images")
}

/// A resident's check of a claimed fix, with a photo as evidence (F3).
model FixCheck {
  id         String     @id @default(uuid()) @db.Uuid
  reportId   String     @map("report_id") @db.Uuid
  userId     String     @map("user_id") @db.Uuid
  imageId    String     @unique @map("image_id") @db.Uuid
  verdict    FixVerdict
  /// Which attempt at a fix this checks: the report's resolved_at at the time.
  resolvedAt DateTime   @map("resolved_at")
  createdAt  DateTime   @default(now()) @map("created_at")

  report Report      @relation(fields: [reportId], references: [id], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id])
  image  ReportImage @relation(fields: [imageId], references: [id], onDelete: Cascade)

  // One response per person per attempt; the next fix can be checked afresh.
  // Also serves counting one attempt's checks by verdict.
  @@unique([reportId, resolvedAt, userId])
  @@index([reportId, createdAt])
  @@map("fix_checks")
}

model Comment {
  id        String   @id @default(uuid()) @db.Uuid
  reportId  String   @map("report_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  content   String
  isDeleted Boolean  @default(false) @map("is_deleted")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@index([reportId])
  @@map("comments")
}

model Vote {
  id        String   @id @default(uuid()) @db.Uuid
  reportId  String   @map("report_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  voteType  VoteType @map("vote_type")
  createdAt DateTime @default(now()) @map("created_at")

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  // Enforces VOTE-003/004, ABUSE-001: one vote of each type per user per report.
  @@unique([reportId, userId, voteType])
  @@index([reportId])
  @@map("votes")
}

model StatusHistory {
  id        String        @id @default(uuid()) @db.Uuid
  reportId  String        @map("report_id") @db.Uuid
  oldStatus ReportStatus? @map("old_status")
  newStatus ReportStatus  @map("new_status")
  changedBy String        @map("changed_by") @db.Uuid
  note      String?
  createdAt DateTime      @default(now()) @map("created_at")

  report  Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  changer User   @relation("StatusChanger", fields: [changedBy], references: [id])

  @@index([reportId])
  @@map("status_history")
}

model ReportAssignment {
  id           String   @id @default(uuid()) @db.Uuid
  reportId     String   @map("report_id") @db.Uuid
  departmentId String   @map("department_id") @db.Uuid
  assignedBy   String   @map("assigned_by") @db.Uuid
  note         String?
  isCurrent    Boolean  @default(true) @map("is_current")
  createdAt    DateTime @default(now()) @map("created_at")

  report     Report     @relation(fields: [reportId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id])
  author     User       @relation("AssignmentAuthor", fields: [assignedBy], references: [id])

  @@index([reportId])
  @@index([departmentId])
  // Public scorecards (F2) read current assignments per department.
  @@index([isCurrent, departmentId])
  @@map("report_assignments")
}

model ReportSubscription {
  id        String             @id @default(uuid()) @db.Uuid
  reportId  String             @map("report_id") @db.Uuid
  userId    String             @map("user_id") @db.Uuid
  source    SubscriptionSource
  createdAt DateTime           @default(now()) @map("created_at")

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@unique([reportId, userId])
  @@index([reportId])
  @@map("report_subscriptions")
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  reportId  String?          @map("report_id") @db.Uuid
  title     String           @db.VarChar(180)
  message   String
  type      NotificationType
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at")

  user   User    @relation(fields: [userId], references: [id])
  report Report? @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}
